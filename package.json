{
  "name": "dsh-safety-net",
  "version": "0.1.3",
  "description": "Self-protection guardrails for the DeepSeek Harness: protected-path interception, backup-before-destroy, CLI self-recovery commands, and strict sandbox defaulting",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "safety",
    "guardrails"
  ],
  "author": "Asuna486-desuwa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asuna486-desuwa/dsh-safety-net.git"
  },
  "homepage": "https://github.com/Asuna486-desuwa/dsh-safety-net#readme",
  "bugs": {
    "url": "https://github.com/Asuna486-desuwa/dsh-safety-net/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": ">=0.0.1-rc.1",
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
